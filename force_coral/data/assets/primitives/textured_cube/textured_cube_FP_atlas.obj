# Textured, triangulated unit cube with 3x2 UV atlas for FoundationPose
# - Single material via MTL (map_Kd)
# - UVs in [0,1] using a 3x2 grid (unique region per face)
# - Per-vertex normals (one normal per face vertex)
# - 1 meter edge length ([-0.5,0.5] cube)

mtllib textured_cube_FP_atlas.mtl
o TexturedCube_FP_Atlas
s off

# Helper (grid cell edges)
# U: 0.0, 0.3333333333, 0.6666666667, 1.0
# V: 0.0, 0.5, 1.0

# Face regions (u0,u1 ; v0,v1)
# Left  (-X):  [0.0, 0.3333333333]  x [0.0, 0.5]
# Front (+Z):  [0.3333333333, 0.6666666667] x [0.0, 0.5]
# Right (+X):  [0.6666666667, 1.0] x [0.0, 0.5]
# Back  (-Z):  [0.0, 0.3333333333]  x [0.5, 1.0]
# Top   (+Y):  [0.3333333333, 0.6666666667] x [0.5, 1.0]
# Bottom(-Y):  [0.6666666667, 1.0] x [0.5, 1.0]

usemtl material0

# Front (+Z)
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5
vt 0.3333333333 0.0
vt 0.6666666667 0.0
vt 0.6666666667 0.5
vt 0.3333333333 0.5
vn 0.0 0.0 1.0
vn 0.0 0.0 1.0
vn 0.0 0.0 1.0
vn 0.0 0.0 1.0
f 1/1/1 2/2/2 3/3/3
f 1/1/1 3/3/3 4/4/4

# Back (-Z)
v -0.5 -0.5 -0.5
v -0.5  0.5 -0.5
v  0.5  0.5 -0.5
v  0.5 -0.5 -0.5
vt 0.0 0.5
vt 0.3333333333 0.5
vt 0.3333333333 1.0
vt 0.0 1.0
vn 0.0 0.0 -1.0
vn 0.0 0.0 -1.0
vn 0.0 0.0 -1.0
vn 0.0 0.0 -1.0
f 5/5/5 6/6/6 7/7/7
f 5/5/5 7/7/7 8/8/8

# Left (-X)
v -0.5 -0.5 -0.5
v -0.5 -0.5  0.5
v -0.5  0.5  0.5
v -0.5  0.5 -0.5
vt 0.0 0.0
vt 0.3333333333 0.0
vt 0.3333333333 0.5
vt 0.0 0.5
vn -1.0 0.0 0.0
vn -1.0 0.0 0.0
vn -1.0 0.0 0.0
vn -1.0 0.0 0.0
f 9/9/9 10/10/10 11/11/11
f 9/9/9 11/11/11 12/12/12

# Right (+X)
v 0.5 -0.5 -0.5
v 0.5  0.5 -0.5
v 0.5  0.5  0.5
v 0.5 -0.5  0.5
vt 0.6666666667 0.0
vt 1.0 0.0
vt 1.0 0.5
vt 0.6666666667 0.5
vn 1.0 0.0 0.0
vn 1.0 0.0 0.0
vn 1.0 0.0 0.0
vn 1.0 0.0 0.0
f 13/13/13 14/14/14 15/15/15
f 13/13/13 15/15/15 16/16/16

# Top (+Y)
v -0.5 0.5 -0.5
v -0.5 0.5  0.5
v  0.5 0.5  0.5
v  0.5 0.5 -0.5
vt 0.3333333333 0.5
vt 0.6666666667 0.5
vt 0.6666666667 1.0
vt 0.3333333333 1.0
vn 0.0 1.0 0.0
vn 0.0 1.0 0.0
vn 0.0 1.0 0.0
vn 0.0 1.0 0.0
f 17/17/17 18/18/18 19/19/19
f 17/17/17 19/19/19 20/20/20

# Bottom (-Y)
v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5 -0.5  0.5
v -0.5 -0.5  0.5
vt 0.6666666667 0.5
vt 1.0 0.5
vt 1.0 1.0
vt 0.6666666667 1.0
vn 0.0 -1.0 0.0
vn 0.0 -1.0 0.0
vn 0.0 -1.0 0.0
vn 0.0 -1.0 0.0
f 21/21/21 22/22/22 23/23/23
f 21/21/21 23/23/23 24/24/24

