(define (problem my_floor_manipulation)
  (:domain robosuite)
  (:language Pick the blue box and place it in the basket)

  (:regions
    (bin_region
      (:target floor)
      (:ranges (
        (-0.01 0.25 0.01 0.27)
      ))
    )
    (target_object_region
      (:target floor)
      (:ranges (
        (0.025 -0.125 0.07500000000000001 -0.07500000000000001)
      ))
    )
    (other_object_region_0
      (:target floor)
      (:ranges (
        (-0.145 -0.265 -0.095 -0.215)
      ))
    )
    (other_object_region_1
      (:target floor)
      (:ranges (
        (-0.175 0.034999999999999996 -0.125 0.08499999999999999)
      ))
    )
    (other_object_region_2
      (:target floor)
      (:ranges (
        (0.07500000000000001 -0.225 0.125 -0.17500000000000002)
      ))
    )
    (other_object_region_3
      (:target floor)
      (:ranges (
        (0.125 0.0049999999999999975 0.175 0.055)
      ))
    )
    (contain_region
      (:target basket_1)
    )
  )

  (:fixtures
    floor - floor
  )

  (:objects
    blue_box_1   - small_blue_box
    basket_1     - basket
    red_box_1    - small_red_box
    green_box_1  - small_green_box
    yellow_box_1 - small_yellow_box
    purple_box_1 - small_purple_box
  )

  (:obj_of_interest
    blue_box_1
    basket_1
  )

  (:init
    (On blue_box_1   floor_target_object_region)
    (On red_box_1    floor_other_object_region_0)
    (On green_box_1  floor_other_object_region_1)
    (On yellow_box_1 floor_other_object_region_2)
    (On purple_box_1 floor_other_object_region_3)
    (On basket_1     floor_bin_region)
  )

  (:goal
    (And (In blue_box_1 basket_1_contain_region))
  )
)
