(define (problem my_floor_manipulation)
  (:domain robosuite)
  (:language Pick the green box and place it in the basket)

  (:regions
    (bin_region
      (:target floor)
      (:ranges (
        (-0.01 0.25 0.01 0.27)
      ))
    )
    (target_object_region
      (:target floor)
      (:ranges (
        (-0.145 -0.265 -0.095 -0.215)
      ))
    )
    (contain_region
      (:target basket_1)
    )
  )

  (:fixtures
    floor - floor
  )

  (:objects
    green_box_1 - small_green_box
    basket_1    - basket
  )

  (:obj_of_interest
    green_box_1
    basket_1
  )

  (:init
    (On green_box_1 floor_target_object_region)
    (On basket_1   floor_bin_region)
  )

  (:goal
    (And (In green_box_1 basket_1_contain_region))
  )
)

