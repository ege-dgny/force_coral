(define (problem my_floor_manipulation)
  (:domain robosuite)
  (:language Press the spring button straight down and hold it at a target depth)

  (:regions
    (button_region
      (:target floor)
      (:ranges (
        (-0.0500001 -0.0500001 -0.05 -0.05)
      ))
    )
  )

  (:fixtures
    floor          - floor
    spring_button_1 - spring_button
  )

  (:obj_of_interest
    spring_button_1
  )

  (:init
    (On spring_button_1 floor_button_region)
  )

  ;; BDDL goal is a placeholder — FORTE's SustainedForceMonitor scores
  ;; success at the run level. (True ...) trivially passes; ignore_done=True
  ;; in build_inner_env prevents premature termination.
  (:goal
    (And (True spring_button_1))
  )
)
